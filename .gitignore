# Project docs are kept locally, not in the repo, except the AppStore material
# (documentation, samples, images), which is published. The built package is not.
Documentation/*
!Documentation/appstore/
Documentation/appstore/*.sdlplugin

# Claude Code session settings and the project instructions, which name local paths.
.claude/
/CLAUDE.md

# Crash-dump folders Windows error reporting drops next to whatever crashed.
ErrorReports/

# Trados artefacts from smoke-testing against files in test-corpus. Studio writes its
# project next to the source file, so these appear in the working tree unbidden.
*.sdlproj
*.sdlxliff
*.sdlppx
*.sdlrpx
*_AutoSave/
*.bak.sdlxliff
multifarious_CLDR/test-corpus/*_??-??_??-??/

# Local test-corpus scratch, not part of the tracked corpus.
multifarious_CLDR/test-corpus/errors/
multifarious_CLDR/test-corpus/**/* - Copy.*

