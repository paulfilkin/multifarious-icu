<UserControl x:Class="multifarious.Icu.BatchTasks.Settings.Views.IcuExpandSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:multifarious.Icu.BatchTasks.Resources"
             xmlns:views="clr-namespace:multifarious.Icu.BatchTasks.Settings.Views"
             KeyboardNavigation.TabNavigation="Continue">
  <!-- The Expand ICU page as the wizards show it: two tabs, the task's options and the grammar
       dictionary. Each tab is a control of its own, so the ICU Settings dialog can host them as
       tabs of its own beside the Restore page. Studio binds one settings page to a task, which is
       why the dictionary is a tab here rather than a page. -->
  <TabControl Margin="0" Padding="0" BorderThickness="0,1,0,0">
    <TabItem Header="{x:Static res:UIStrings.Settings_OptionsTab}">
      <views:IcuExpandOptionsView />
    </TabItem>
    <TabItem Header="{x:Static res:UIStrings.Settings_GrammarTab}">
      <views:IcuGrammarSettingsView DataContext="{Binding Grammar}" />
    </TabItem>
  </TabControl>
</UserControl>
