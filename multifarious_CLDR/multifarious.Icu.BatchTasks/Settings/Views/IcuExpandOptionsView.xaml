<UserControl x:Class="multifarious.Icu.BatchTasks.Settings.Views.IcuExpandOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:multifarious.Icu.BatchTasks.Resources"
             xmlns:views="clr-namespace:multifarious.Icu.BatchTasks.Settings.Views"
             KeyboardNavigation.TabNavigation="Continue"
             PreviewKeyDown="OnPreviewKeyDown">
  <!-- The Options tab of the Expand ICU page: the task's settings in the order the task decides
       them. Which messages are expanded and how far (kinds and budget), which are left as they are
       (already translated), what each segment holds (source text and placeholders), and what
       happens when a value does not parse. The grammar dictionary is the other tab,
       IcuGrammarSettingsView. Strings come from UIStrings.resx via x:Static, so a renamed entry is
       a compile error rather than a blank label. Studio's own control styles, so the page matches
       Studio's chrome. No minimum width: the batch task wizard's settings panel is narrower than
       the file type settings dialog, and a fixed width pushed the right-hand column out of view
       (Project 44). -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Sdl.Desktop.Platform.Styles;component/buttonresources.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Sdl.Desktop.Platform.Styles;component/radiobuttonresources.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Sdl.Desktop.Platform.Styles;component/groupboxresources.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Sdl.Desktop.Platform.Styles;component/textblockresources.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Sdl.Desktop.Platform.Styles;component/checkboxresources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style TargetType="CheckBox" BasedOn="{StaticResource Sdl.Checkbox.GenericStyle}">
        <Setter Property="Margin" Value="0,3,0,3" />
      </Style>
      <Style TargetType="RadioButton" BasedOn="{StaticResource Sdl.RadioButton.GenericStyle}">
        <Setter Property="Margin" Value="0,3,0,3" />
      </Style>
      <Style TargetType="GroupBox" BasedOn="{StaticResource Sdl.GroupBox.SingleLineStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="8" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="20,2,0,8" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Invalid">
        <Setter Property="Foreground" Value="#B00020" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Intro">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <!-- A sub-heading inside a group, where two settings share one group. -->
      <Style TargetType="TextBlock" x:Key="SubHeading">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,2" />
      </Style>
      <!-- The collapsible help under each group, as the sibling file types' pages have. -->
      <Style TargetType="Expander" x:Key="Help">
        <Setter Property="Margin" Value="0,6,0,4" />
        <Setter Property="Foreground" Value="#1A5FB4" />
      </Style>
      <Style TargetType="Border" x:Key="HelpBody">
        <Setter Property="Background" Value="#F7F9FC" />
        <Setter Property="BorderBrush" Value="#D6E0EC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </Style>
      <Style TargetType="TextBlock" x:Key="HelpText">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
    <StackPanel>

      <TextBlock Style="{StaticResource Intro}" Text="{x:Static res:UIStrings.Expand_Intro}" />

      <!-- 1. Which messages, and how far. -->
      <GroupBox Header="{x:Static res:UIStrings.Expand_KindsHeader}">
        <StackPanel>
          <CheckBox TabIndex="10" Content="{x:Static res:UIStrings.Expand_Cardinal}" IsChecked="{Binding ExpandCardinal}" />
          <CheckBox TabIndex="11" Content="{x:Static res:UIStrings.Expand_Ordinal}" IsChecked="{Binding ExpandOrdinal}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UIStrings.Expand_KindsHint}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{x:Static res:UIStrings.Expand_BudgetLabel}" />
            <TextBox TabIndex="12" Width="60" Padding="2" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{x:Static res:UIStrings.Expand_BudgetLabel}"
                     Text="{Binding BudgetText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Invalid}" Text="{x:Static res:UIStrings.Expand_BudgetInvalid}">
            <TextBlock.Visibility>
              <Binding Path="IsBudgetValid">
                <Binding.Converter>
                  <views:InverseBooleanToVisibilityConverter />
                </Binding.Converter>
              </Binding>
            </TextBlock.Visibility>
          </TextBlock>
          <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{x:Static res:UIStrings.Expand_BudgetHint}" />
          <Expander Style="{StaticResource Help}" TabIndex="13" Header="{x:Static res:UIStrings.Expand_KindsHelpHeader}">
            <Border Style="{StaticResource HelpBody}">
              <StackPanel>
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_KindsHelp1}" />
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_KindsHelp2}" Margin="0" />
              </StackPanel>
            </Border>
          </Expander>
          <Expander Style="{StaticResource Help}" TabIndex="14" Header="{x:Static res:UIStrings.Expand_BudgetHelpHeader}">
            <Border Style="{StaticResource HelpBody}">
              <StackPanel>
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_BudgetHelp1}" />
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_BudgetHelp2}" Margin="0" />
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </GroupBox>

      <!-- 2. Which messages are left as they are. -->
      <GroupBox Header="{x:Static res:UIStrings.Expand_KeepHeader}">
        <StackPanel>
          <CheckBox TabIndex="20" Content="{x:Static res:UIStrings.Expand_KeepTranslated}" IsChecked="{Binding KeepTranslated}" />
          <StackPanel Orientation="Horizontal" Margin="20,2,0,0" IsEnabled="{Binding KeepTranslated}">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{x:Static res:UIStrings.Expand_KeepMinimumLabel}" />
            <TextBox TabIndex="21" Width="60" Padding="2" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{x:Static res:UIStrings.Expand_KeepMinimumLabel}"
                     Text="{Binding KeepMinimumText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" Text="%" />
          </StackPanel>
          <TextBlock Style="{StaticResource Invalid}" Margin="20,4,0,0" Text="{x:Static res:UIStrings.Expand_KeepMinimumInvalid}">
            <TextBlock.Visibility>
              <Binding Path="IsKeepMinimumValid">
                <Binding.Converter>
                  <views:InverseBooleanToVisibilityConverter />
                </Binding.Converter>
              </Binding>
            </TextBlock.Visibility>
          </TextBlock>
          <CheckBox TabIndex="22" Margin="20,6,0,3" Content="{x:Static res:UIStrings.Expand_LockKept}" IsChecked="{Binding LockKept}" IsEnabled="{Binding KeepTranslated}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UIStrings.Expand_KeepHint}" />
          <Expander Style="{StaticResource Help}" TabIndex="23" Header="{x:Static res:UIStrings.Expand_KeepHelpHeader}">
            <Border Style="{StaticResource HelpBody}">
              <StackPanel>
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_KeepHelp1}" />
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_KeepHelp2}" Margin="0" />
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </GroupBox>

      <!-- 3. What each segment holds. -->
      <GroupBox Header="{x:Static res:UIStrings.Expand_SegmentsHeader}">
        <StackPanel>
          <TextBlock Style="{StaticResource SubHeading}" Margin="0,0,0,2" Text="{x:Static res:UIStrings.Expand_SeedHeader}" />
          <RadioButton GroupName="Seed" TabIndex="30" Content="{x:Static res:UIStrings.Expand_SeedMatching}" IsChecked="{Binding SeedIsMatchingElseOther}" />
          <RadioButton GroupName="Seed" TabIndex="31" Content="{x:Static res:UIStrings.Expand_SeedAlwaysOther}" IsChecked="{Binding SeedIsAlwaysOther}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UIStrings.Expand_SeedHint}" />
          <Expander Style="{StaticResource Help}" TabIndex="32" Header="{x:Static res:UIStrings.Expand_SeedHelpHeader}">
            <Border Style="{StaticResource HelpBody}">
              <StackPanel>
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_SeedHelp1}" />
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_SeedHelp2}" Margin="0" />
              </StackPanel>
            </Border>
          </Expander>

          <TextBlock Style="{StaticResource SubHeading}" Text="{x:Static res:UIStrings.Expand_PlaceholdersHeader}" />
          <CheckBox TabIndex="33" Content="{x:Static res:UIStrings.Expand_LockPlaceholders}" IsChecked="{Binding LockPlaceholders}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UIStrings.Expand_LockHint}" />
          <Expander Style="{StaticResource Help}" TabIndex="34" Header="{x:Static res:UIStrings.Expand_PlaceholdersHelpHeader}">
            <Border Style="{StaticResource HelpBody}">
              <StackPanel>
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_PlaceholdersHelp1}" />
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_PlaceholdersHelp2}" Margin="0" />
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </GroupBox>

      <!-- 4. When a value does not parse. -->
      <GroupBox Header="{x:Static res:UIStrings.Expand_ParseHeader}">
        <StackPanel>
          <RadioButton GroupName="Parse" TabIndex="40" Content="{x:Static res:UIStrings.Expand_ParsePassThrough}" IsChecked="{Binding ParseErrorPassesThrough}" />
          <RadioButton GroupName="Parse" TabIndex="41" Content="{x:Static res:UIStrings.Expand_ParseFail}" IsChecked="{Binding ParseErrorFailsTask}" />
          <Expander Style="{StaticResource Help}" TabIndex="42" Header="{x:Static res:UIStrings.Expand_ParseHelpHeader}">
            <Border Style="{StaticResource HelpBody}">
              <StackPanel>
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_ParseHelp1}" />
                <TextBlock Style="{StaticResource HelpText}" Text="{x:Static res:UIStrings.Expand_ParseHelp2}" Margin="0" />
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </GroupBox>

    </StackPanel>
  </ScrollViewer>
</UserControl>
