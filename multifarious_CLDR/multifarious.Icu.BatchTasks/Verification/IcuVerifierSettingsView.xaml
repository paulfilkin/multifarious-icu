<UserControl x:Class="multifarious.Icu.BatchTasks.Verification.IcuVerifierSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:multifarious.Icu.BatchTasks.Resources">
  <!-- The ICU verifier's page under Verification: the Enabled tick box Studio expects every
       verifier to offer, and a severity for each of the four checks. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Sdl.Desktop.Platform.Styles;component/checkboxresources.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Sdl.Desktop.Platform.Styles;component/textblockresources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="CheckBox" BasedOn="{StaticResource Sdl.Checkbox.GenericStyle}" />
      <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,10" />
      </Style>
      <Style TargetType="TextBlock" x:Key="Row">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style TargetType="ComboBox" x:Key="Severity">
        <Setter Property="Width" Value="150" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
    <StackPanel>
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="{x:Static res:UIStrings.VerifierPage_Intro}" />

      <CheckBox TabIndex="10" Content="{x:Static res:UIStrings.VerifierPage_Enabled}" IsChecked="{Binding Enabled}" Margin="0,0,0,12" />

      <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="{x:Static res:UIStrings.VerifierPage_SeverityHeader}" />
      <Grid IsEnabled="{Binding Enabled}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Row}" Text="{x:Static res:UIStrings.VerifierPage_CheckEmptyForm}" />
        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Severity}" TabIndex="20"
                  AutomationProperties.Name="{x:Static res:UIStrings.VerifierPage_CheckEmptyForm}"
                  ItemsSource="{Binding Severities, Mode=OneWay}" SelectedItem="{Binding EmptyForm}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Row}" Text="{x:Static res:UIStrings.VerifierPage_CheckPlaceholders}" />
        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Severity}" TabIndex="21"
                  AutomationProperties.Name="{x:Static res:UIStrings.VerifierPage_CheckPlaceholders}"
                  ItemsSource="{Binding Severities, Mode=OneWay}" SelectedItem="{Binding Placeholders}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Row}" Text="{x:Static res:UIStrings.VerifierPage_CheckTypedPound}" />
        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Severity}" TabIndex="22"
                  AutomationProperties.Name="{x:Static res:UIStrings.VerifierPage_CheckTypedPound}"
                  ItemsSource="{Binding Severities, Mode=OneWay}" SelectedItem="{Binding TypedPound}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Row}" Text="{x:Static res:UIStrings.VerifierPage_CheckInvalid}" />
        <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Severity}" TabIndex="23"
                  AutomationProperties.Name="{x:Static res:UIStrings.VerifierPage_CheckInvalid}"
                  ItemsSource="{Binding Severities, Mode=OneWay}" SelectedItem="{Binding Invalid}" />
      </Grid>

      <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{x:Static res:UIStrings.VerifierPage_Hint}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
